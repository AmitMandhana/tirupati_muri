# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT is chosen by the host in production (Render sets it automatically).
PORT=5000

# Use "production" when deployed so 5xx details are hidden and logs are combined.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/tirupati_muri
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tirupati_muri?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use a long random string (at least 32 characters). Never commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-characters

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of every frontend origin allowed to call the API.
# Local:      http://localhost:5173
# Vercel:     https://your-app.vercel.app,https://your-domain.com
CLIENT_URL=http://localhost:5173

# Set to "true" when the app runs behind a reverse proxy/load balancer
# (Render, Railway, Nginx) so rate limiting sees the real client IP.
TRUST_PROXY=false
